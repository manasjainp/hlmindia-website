Options -Indexes

<FilesMatch "\.(json|log|ini|env|git|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Custom Error Pages
ErrorDocument 403 /403.php
ErrorDocument 404 /404.html

# 5. Hotlink Protection (Protect Assets)
# Prevents other websites from linking directly to your images
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteCond %{HTTP_REFERER} !^$
    # RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?hlmindia\.com [NC]
    # RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?hlmindia\.unaux\.com [NC]
    # RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?localhost [NC]
    # RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?127\.0\.0\.1 [NC]
    # RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [NC,F,L]
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
    # Prevent site from being embedded in iframes (Clickjacking protection)
    Header set X-Frame-Options "SAMEORIGIN"
    # Prevent browser from guessing content types
    Header set X-Content-Type-Options "nosniff"
</IfModule>